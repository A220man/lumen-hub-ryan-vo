# Lumen Hub Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=lumen-hub
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lumen_hub

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=lumen-hub
KEYCLOAK_CLIENT_ID=lumen-hub-backend
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER_URL=http://localhost:8080/realms/lumen-hub
OIDC_JWKS_URL=http://localhost:8080/realms/lumen-hub/protocol/openid-connect/certs
OIDC_AUDIENCE=lumen-hub-api

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (for email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=30
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Lumen Hub

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Demo mode (localhost only)
DEMO_MODE=false